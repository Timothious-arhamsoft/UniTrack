# PostgreSQL Database Configuration
POSTGRES_USER=unitrack
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=unitrack_db

# Application Configuration
DATABASE_URL=postgresql://unitrack:your_secure_password_here@db:5432/unitrack_db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gemini
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Groq / Hosted AI Model Configuration for Unibot
HOSTED_BASE_URL=https://api.groq.com/openai/v1
HOSTED_API_KEY=your_hosted_or_groq_api_key_here
HOSTED_MODEL=llama-3.3-70b-versatile